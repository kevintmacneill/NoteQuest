{
  "schema": "notequest-ui-personalization/1",
  "status": "design prototype, no engine writes",
  "learnerPresentation": [
    "picture",
    "child",
    "adult"
  ],
  "independentFrom": [
    "age",
    "name",
    "ability",
    "progress",
    "coins",
    "pets"
  ],
  "engineReads": [
    "NQ.learn.learner()",
